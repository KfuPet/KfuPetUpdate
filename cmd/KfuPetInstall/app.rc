// Windows 资源定义：为 KfuPetInstall.exe 设置图标。
// 通过 windres 编译为 *.syso，go build 会自动链入可执行文件。
//
// 1         —— 数字 ID 最小，作为 exe 文件图标（资源管理器/任务栏固定时显示）
// GLFW_ICON —— Fyne 底层的 GLFW 按这个名字查找窗口图标（win32_window.c 中
//              LoadImageW(..., L"GLFW_ICON", ...)），找不到会退回系统通用图标。
//              两处指向同一个多尺寸 ICO，系统按需取 16/32 等原生尺寸。
1         ICON "icon/app.ico"
GLFW_ICON ICON "icon/app.ico"

// 应用程序清单：声明 requireAdministrator，使 exe 启动即索取管理员权限。
// 资源类型 24 即 RT_MANIFEST，名称必须为 1，Windows 才认。
1 24 "app.manifest"

// Windows 资源定义：为 KfuPetInstall.exe 设置「属性 → 详细信息」页内容。
1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L  // VOS_NT_WINDOWS32
FILETYPE        0x1L      // VFT_APP
FILESUBTYPE     0x0L      // VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = 简体中文(zh-CN)，04b0 = 1200(Unicode)
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "KfuPet"
            VALUE "FileDescription",  "KfuPet 安装 / 更新 / 卸载程序"
            VALUE "FileVersion",      "2.0.0"
            VALUE "InternalName",     "KfuPetInstall"
            VALUE "LegalCopyright",   "Copyright (C) 2026 KfuPet"
            VALUE "OriginalFilename", "KfuPetInstall.exe"
            VALUE "ProductName",      "KfuPetInstall"
            VALUE "ProductVersion",   "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
